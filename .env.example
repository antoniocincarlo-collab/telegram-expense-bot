# === Telegram ===
TELEGRAM_BOT_TOKEN=il-tuo-token-da-botfather

# === PostgreSQL ===
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/expense_bot

# === Groq API (LLM fallback gratuito) ===
GROQ_API_KEY=la-tua-chiave-groq

# === Tink PSD2 (sandbox gratuito) ===
TINK_CLIENT_ID=il-tuo-client-id
TINK_CLIENT_SECRET=il-tuo-client-secret

# === Opzionale: soglia confidence ML (default 0.7) ===
ML_CONFIDENCE_THRESHOLD=0.7

# === Opzionale: path modello ML salvato ===
ML_MODEL_PATH=ml_model.joblib
ML_VECTORIZER_PATH=ml_vectorizer.joblib
